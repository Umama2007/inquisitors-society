# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inquisitors_society

# ── JWT ──
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRY=24h

# ── Server URLs ──
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ── Frontend (Next.js public) ──
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ── SMTP (optional — notifications) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@inquisitors-society.local

# ── AI Chatbot (optional — OpenAI-compatible) ──
AI_CHATBOT_API_KEY=
AI_CHATBOT_MODEL=gpt-3.5-turbo
AI_CHATBOT_API_URL=https://api.openai.com/v1/chat/completions
